# ── Supabase ──────────────────────────────────────────────────────────────────
# Récupérer dans : Supabase Dashboard > Settings > API
VITE_SUPABASE_URL=https://VOTRE_PROJECT_ID.supabase.co
VITE_SUPABASE_ANON_KEY=votre_anon_public_key

# ── Cloudinary ────────────────────────────────────────────────────────────────
# Récupérer dans : Cloudinary Dashboard > Settings > Account
VITE_CLOUDINARY_CLOUD_NAME=votre_cloud_name
VITE_CLOUDINARY_UPLOAD_PRESET=pivot_unsigned   # Créer un Upload Preset "Unsigned" dans Cloudinary

# ── IA Primaire — Groq ────────────────────────────────────────────────────────
# Récupérer dans : console.groq.com > API Keys
VITE_GROQ_API_KEY=gsk_votre_groq_api_key

# ── IA Secondaire — Google Gemini (fallback automatique) ──────────────────────
# Récupérer dans : aistudio.google.com > Get API Key
VITE_GEMINI_API_KEY=votre_gemini_api_key

# ── App ───────────────────────────────────────────────────────────────────────
VITE_APP_URL=http://localhost:5173
